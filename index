<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khu Vườn Hoa Hồng 20-10</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow: hidden;
            background-color: #0d0510;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
        }

        #canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
        }

        /* Overlay UI */
        .ui-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            pointer-events: none;
        }

        .card {
            background: rgba(255, 240, 245, 0.15);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 24px;
            padding: 30px 40px;
            text-align: center;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(255, 182, 193, 0.3);
            pointer-events: auto;
            transform: scale(0.8);
            opacity: 0;
            transition: all 1s ease-in-out;
        }

        .card.active {
            transform: scale(1);
            opacity: 1;
        }

        h1 {
            color: #ffb7c5;
            font-size: 2.2rem;
            margin-bottom: 15px;
            text-shadow: 0 0 10px rgba(255, 105, 180, 0.8);
        }

        p {
            color: #fff0f5;
            font-size: 1.05rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .btn {
            background: linear-gradient(135deg, #ff4081, #e91e63);
            color: white;
            border: none;
            padding: 12px 28px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(255, 64, 129, 0.6);
            transition: transform 0.2s, box-shadow 0.2s;
            pointer-events: auto;
        }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(255, 64, 129, 0.9);
        }

        #start-btn {
            position: absolute;
            bottom: 50px;
        }
    </style>
</head>
<body>

    <canvas id="canvas"></canvas>

    <div class="ui-container">
        <button id="start-btn" class="btn" onclick="startJourney()">Tảo Báo Tiến Vào Khu Vườn</button>

        <div id="wish-card" class="card">
            <h1>Chúc Mừng Ngày 20/10! 🌹</h1>
            <p>
                Nhân ngày Phụ nữ Việt Nam 20/10, chúc bạn luôn rạng rỡ, xinh đẹp và ngát hương như những bông hoa hồng trong khu vườn này! Mong rằng mỗi ngày trôi qua đều mang đến cho bạn niềm vui, hạnh phúc và bình yên. ✨
            </p>
            <button class="btn" onclick="restartJourney()">Dạo Vườn Lần Nữa</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        // Trạng thái ứng dụng
        let progress = 0; // Tiến trình di chuyển vào con đường (0 -> 1)
        let isMoving = false;

        // Quản lý các đối tượng
        const petals = [];
        const butterflies = [];
        const birds = [];

        // Tạo cánh hoa rơi
        for (let i = 0; i < 80; i++) {
            petals.push({
                x: Math.random() * width,
                y: Math.random() * height,
                size: Math.random() * 6 + 4,
                speedY: Math.random() * 1.5 + 0.5,
                speedX: Math.random() * 1 - 0.5,
                angle: Math.random() * Math.PI * 2,
                spin: (Math.random() - 0.5) * 0.05
            });
        }

        // Tạo bướm
        for (let i = 0; i < 6; i++) {
            butterflies.push({
                x: Math.random() * width,
                y: Math.random() * height * 0.6,
                size: Math.random() * 8 + 8,
                vx: (Math.random() - 0.5) * 1.5,
                vy: (Math.random() - 0.5) * 1,
                wingAngle: 0,
                wingSpeed: 0.15 + Math.random() * 0.1,
                color: ['#ff80ab', '#ea80fc', '#ffd54f'][Math.floor(Math.random() * 3)]
            });
        }

        // Tạo chim
        for (let i = 0; i < 4; i++) {
            birds.push({
                x: -100 - Math.random() * 200,
                y: 50 + Math.random() * 150,
                size: 15 + Math.random() * 10,
                vx: 1.5 + Math.random() * 1,
                wing: 0
            });
        }

        // Vẽ Hoa Hồng
        function drawRose(x, y, scale) {
            ctx.save();
            ctx.translate(x, y);
            ctx.scale(scale, scale);

            // Cành hoa
            ctx.strokeStyle = '#2e7d32';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.quadraticCurveTo(-10, 40, -5, 80);
            ctx.stroke();

            // Lá hoa
            ctx.fillStyle = '#388e3c';
            ctx.beginPath();
            ctx.ellipse(-10, 45, 12, 6, Math.PI / 4, 0, Math.PI * 2);
            ctx.fill();

            // Cánh hoa hồng (Xếp lớp)
            const colors = ['#880e4f', '#c2185b', '#d81b60', '#e91e63', '#ff4081'];
            for (let i = colors.length - 1; i >= 0; i--) {
                ctx.fillStyle = colors[i];
                ctx.beginPath();
                const r = (i + 1) * 6;
                ctx.arc(0, 0, r, 0, Math.PI * 2);
                ctx.fill();
            }

            // Nhụy hoa
            ctx.fillStyle = '#ff80ab';
            ctx.beginPath();
            ctx.arc(-2, -2, 5, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }

        // Vẽ con đường tiến vào
        function drawPath() {
            ctx.save();
            
            // Điểm xuất phát và điểm kết thúc của con đường
            const startW = width * 0.5;
            const endW = width * 0.1 + (progress * width * 0.15);
            
            const startY = height;
            const endY = height * 0.45 + (progress * height * 0.1);

            // Mặt đường đá
            const gradient = ctx.createLinearGradient(0, startY, 0, endY);
            gradient.addColorStop(0, '#4a2c40');
            gradient.addColorStop(1, '#1a0926');

            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.moveTo(width / 2 - startW / 2, startY);
            ctx.quadraticCurveTo(width / 2 - 50, (startY + endY) / 2, width / 2 - endW / 2, endY);
            ctx.lineTo(width / 2 + endW / 2, endY);
            ctx.quadraticCurveTo(width / 2 + 50, (startY + endY) / 2, width / 2 + startW / 2, startY);
            ctx.closePath();
            ctx.fill();

            // Hàng rào hoa hồng 2 bên đường
            const numRoses = 12;
            for (let i = 0; i < numRoses; i++) {
                const t = i / numRoses;
                const pY = startY - (startY - endY) * t;
                const currentW = startW - (startW - endW) * t;
                const scale = (1 - t * 0.7) * (1 + progress * 0.3);

                // Hoa bên trái
                const leftX = (width / 2 - currentW / 2) - 20 * (1 - t);
                drawRose(leftX, pY, scale);

                // Hoa bên phải
                const rightX = (width / 2 + currentW / 2) + 20 * (1 - t);
                drawRose(rightX, pY, scale);
            }

            ctx.restore();
        }

        // Loop Animation chính
        function animate() {
            // Nền bầu trời đêm
            const bgGradient = ctx.createLinearGradient(0, 0, 0, height);
            bgGradient.addColorStop(0, '#0d0510');
            bgGradient.addColorStop(0.6, '#2a0826');
            bgGradient.addColorStop(1, '#4a1235');
            ctx.fillStyle = bgGradient;
            ctx.fillRect(0, 0, width, height);

            // Vẽ Mặt trăng / Ánh sáng huyền ảo ở giữa
            ctx.save();
            const moonGlow = ctx.createRadialGradient(width / 2, height * 0.3, 10, width / 2, height * 0.3, 200);
            moonGlow.addColorStop(0, 'rgba(255, 220, 240, 0.8)');
            moonGlow.addColorStop(0.5, 'rgba(255, 105, 180, 0.2)');
            moonGlow.addColorStop(1, 'transparent');
            ctx.fillStyle = moonGlow;
            ctx.beginPath();
            ctx.arc(width / 2, height * 0.3, 200, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            // Vẽ Con Đường & Hoa Hồng
            drawPath();

            // Cập nhật & Vẽ Bướm
            butterflies.forEach(b => {
                b.x += b.vx;
                b.y += b.vy;
                b.wingAngle += b.wingSpeed;

                if (b.x < 0 || b.x > width) b.vx *= -1;
                if (b.y < 0 || b.y > height * 0.7) b.vy *= -1;

                ctx.save();
                ctx.translate(b.x, b.y);
                ctx.fillStyle = b.color;
                
                // Cánh trái
                ctx.save();
                ctx.scale(Math.sin(b.wingAngle), 1);
                ctx.beginPath();
                ctx.arc(-b.size / 2, 0, b.size / 2, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();

                // Cánh phải
                ctx.save();
                ctx.scale(Math.sin(b.wingAngle), 1);
                ctx.beginPath();
                ctx.arc(b.size / 2, 0, b.size / 2, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();

                ctx.restore();
            });

            // Cập nhật & Vẽ Chim
            birds.forEach(b => {
                b.x += b.vx;
                b.wing += 0.15;

                if (b.x > width + 100) b.x = -100;

                ctx.save();
                ctx.translate(b.x, b.y);
                ctx.strokeStyle = '#fbcfe8';
                ctx.lineWidth = 2;
                ctx.beginPath();
                const wingY = Math.sin(b.wing) * 8;
                ctx.moveTo(-b.size, wingY);
                ctx.quadraticCurveTo(-b.size / 2, -10, 0, 0);
                ctx.quadraticCurveTo(b.size / 2, -10, b.size, wingY);
                ctx.stroke();
                ctx.restore();
            });

            // Cập nhật & Vẽ Cánh Hoa Rơi
            petals.forEach(p => {
                p.y += p.speedY;
                p.x += Math.sin(p.angle) + p.speedX;
                p.angle += p.spin;

                if (p.y > height) {
                    p.y = -10;
                    p.x = Math.random() * width;
                }

                ctx.save();
                ctx.translate(p.x, p.y);
                ctx.rotate(p.angle);
                ctx.fillStyle = '#ff4081';
                ctx.beginPath();
                ctx.ellipse(0, 0, p.size, p.size / 2, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Xử lý di chuyển camera
            if (isMoving && progress < 1) {
                progress += 0.008;
                if (progress >= 1) {
                    progress = 1;
                    isMoving = false;
                    document.getElementById('wish-card').classList.add('active');
                }
            } else if (!isMoving && progress > 0 && progress < 1) {
                progress -= 0.01;
                if (progress <= 0) progress = 0;
            }

            requestAnimationFrame(animate);
        }

        function startJourney() {
            document.getElementById('start-btn').style.display = 'none';
            isMoving = true;
        }

        function restartJourney() {
            document.getElementById('wish-card').classList.remove('active');
            progress = 0.99;
            setTimeout(() => {
                isMoving = false;
                document.getElementById('start-btn').style.display = 'block';
            }, 500);
        }

        animate();
    </script>
</body>
</html>
